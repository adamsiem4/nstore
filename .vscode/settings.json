{
  // Tailwind v4 keeps its config in CSS (@theme, @custom-variant, @apply);
  // VS Code's built-in CSS parser only knows plain CSS at-rules.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss",
    // Bun writes its lockfile as JSONC (trailing commas), not strict JSON.
    "bun.lock": "jsonc"
  },
  "json.schemas": [
    { "fileMatch": ["bun.lock"], "schema": { "allowTrailingCommas": true } }
  ]
}
